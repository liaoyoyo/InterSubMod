    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/knowledge_check.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c \"if echo '$TOOL_INPUT' | grep -qE '(rm -rf|git reset --hard|git push --force)'; then echo '[PreHook] 危險操作警告！請確認操作正確性'; fi\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read file_path; if echo \"$file_path\" | grep -qE '\\.(cpp|hpp|h)$'; then echo '[Hook] C++ 程式碼已修改，請記得：1. 編譯 (cd build && make) 2. 測試'; fi; }"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | { read cmd; if echo \"$cmd\" | grep -q 'git commit'; then echo '[Hook] 提交完成，請確認：1. 測試已通過 2. 文檔已更新'; fi; }"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[SubagentStop] 子代理任務完成，請檢查輸出結果並確認是否符合預期'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[Hook] 會話即將結束，請確認：\\n1. 是否已撰寫執行報告到 docs/ai_sessions/\\n2. 是否有未完成的任務需要記錄\\n3. 使用 /report 技能撰寫報告'"
          }
        ]
      }
    ]
  },
  "outputStyle": "default",
  "sandbox": {
    "enabled": true,
    "mode": "docker",
    "containerImage": "debian:bookworm"
  },
  "remote": {
    "defaultEnvironmentId": "env_01PzQvyh42s16EdwAsEyV5Ei"
  },
  "autoUpdater": {
    "enabled": true
  },
  "preferences": {
    "language": "zh-TW",
    "response_language": "繁體中文",
    "code_comment_language": "zh-TW"
  },
  "enabledMcpjsonServers": [
    "knowledge",
    "biorxiv",
    "ensembl"
  ]
}
