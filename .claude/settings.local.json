  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /big7_disk/liaoyoyo2001/InterSubMod/scripts/hooks/knowledge_check.sh 2>/dev/null || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /big7_disk/liaoyoyo2001/InterSubMod/scripts/hooks/research_direction_guard.sh 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | grep -qE '(rm -rf|git reset --hard|git push --force)' && echo '[PreHook] 危險操作警告！請確認操作正確性' || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /big7_disk/liaoyoyo2001/InterSubMod/scripts/hooks/pre_commit_compile_check.sh 2>/dev/null || exit 0"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /big7_disk/liaoyoyo2001/InterSubMod/scripts/hooks/pre_tier_upgrade_check.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /big7_disk/liaoyoyo2001/InterSubMod/scripts/hooks/cpp_edit_guard.sh 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /big7_disk/liaoyoyo2001/InterSubMod/scripts/hooks/trigger_routing.sh 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /big7_disk/liaoyoyo2001/InterSubMod/scripts/hooks/evidence_ledger_sync.sh 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /big7_disk/liaoyoyo2001/InterSubMod/scripts/hooks/terminology_guard.sh 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /big7_disk/liaoyoyo2001/InterSubMod/scripts/hooks/compile_success_clear.sh 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | { read -r cmd; [ -n \"$cmd\" ] && echo \"$cmd\" | grep -q 'git commit' && echo '[Hook] 提交完成，請確認：1. 測試已通過 2. 文檔已更新'; } 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /big7_disk/liaoyoyo2001/InterSubMod/scripts/hooks/post_cpp_commit_invalidate.sh 2>/dev/null || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '[SubagentStop] 子代理任務完成，請檢查輸出結果並確認是否符合預期' || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '[Hook] 會話即將結束，請確認：\\n1. 是否已撰寫執行報告到 docs/ai_sessions/\\n2. 是否有未完成的任務需要記錄\\n3. 使用 /report 技能撰寫報告\\n' || true"
          }
        ]
      }
    ]
