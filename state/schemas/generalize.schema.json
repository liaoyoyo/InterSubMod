{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intersubmod.local/schemas/generalize.schema.json",
  "title": "Generalize Artifact (P4)",
  "description": "Output of Phase 4 GENERALIZE. Cross-sample validation; can be parallel fan-out via parallel-benchmark agent.",
  "type": "object",
  "required": ["schema_version", "cycle_id", "ran_at", "samples", "consistency", "verdict"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "cycle_id": { "type": "string" },
    "ran_at": { "type": "string", "format": "date-time" },
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["sample_id", "metric_value", "passed_threshold"],
        "properties": {
          "sample_id": { "type": "string" },
          "metric_value": { "type": "number" },
          "ci_lower": { "type": ["number", "null"] },
          "ci_upper": { "type": ["number", "null"] },
          "p_value": { "type": ["number", "null"] },
          "passed_threshold": { "type": "boolean" },
          "raw_output": { "type": ["string", "null"] }
        }
      }
    },
    "consistency": {
      "type": "object",
      "description": "Output of multi-sample-consistency skill.",
      "required": ["n_samples_passed", "n_samples_total", "direction_consistency"],
      "properties": {
        "n_samples_passed": { "type": "integer" },
        "n_samples_total": { "type": "integer" },
        "direction_consistency": {
          "type": "string",
          "description": "e.g. '6/6 same sign', '5/7 positive, 1/7 negative, 1/7 null'."
        },
        "wilcoxon_p": { "type": ["number", "null"] },
        "fisher_combined_p": { "type": ["number", "null"] },
        "confidence_uplift": { "type": ["number", "null"] }
      }
    },
    "fan_out_mode": {
      "enum": ["sequential", "parallel_subagent", "skipped"],
      "default": "sequential",
      "description": "parallel_subagent → spawned parallel-benchmark agent × N."
    },
    "verdict": {
      "enum": ["consistent", "mixed", "inconsistent"],
      "description": "Triggers evaluator escalation in P5 if mixed/inconsistent."
    }
  }
}
