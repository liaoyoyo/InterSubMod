{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liaoyoyo/InterSubMod/schemas/reader-acceptance.schema.json",
  "title": "Independent fresh-reader semantic acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "receipt_id",
    "evaluated_at",
    "tested_git_commit",
    "evaluator_context",
    "evaluator_id",
    "package_source_manifest",
    "questions",
    "prohibited_promotions",
    "verdict",
    "claim_ceiling"
  ],
  "properties": {
    "schema_name": {"const": "intersubmod.reader_acceptance_receipt"},
    "schema_version": {"const": "2.0.0"},
    "receipt_id": {"const": "intersubmod-reader-acceptance-20260813"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "tested_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evaluator_context": {"const": "NO_PRIOR_CONVERSATION_PACKAGE_ONLY"},
    "evaluator_id": {"type": "string", "minLength": 3},
    "package_source_manifest": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"$ref": "#/$defs/pathHash"}
    },
    "questions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/question"}
    },
    "prohibited_promotions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/promotion"}
    },
    "verdict": {"enum": ["PASS", "BLOCKED"]},
    "claim_ceiling": {
      "const": "Reader comprehension only; not scientific validation, host acceptance, or publication proof."
    }
  },
  "$defs": {
    "pathHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "status", "answer", "evidence_paths", "limits"],
      "properties": {
        "question_id": {
          "enum": [
            "Q_PROJECT",
            "Q_CONCLUSION",
            "Q_FINALITY",
            "Q_SOFTWARE_ROLES",
            "Q_MACHINES",
            "Q_VERIFY_CONTINUE"
          ]
        },
        "status": {"enum": ["PASS", "BLOCKED"]},
        "answer": {"type": "string", "minLength": 80},
        "evidence_paths": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "limits": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 10},
          "uniqueItems": true
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "status", "explanation", "evidence_paths"],
      "properties": {
        "check_id": {
          "enum": [
            "NO_CELLULAR_PROMOTION",
            "NO_ANCESTRY_PROMOTION",
            "NO_882579_ACCURACY_OR_PREVALENCE",
            "NO_TECHNICAL_DATASET_AS_BIOLOGICAL_REPLICATE",
            "NO_FEATURE_AS_MAIN",
            "NO_LOCAL_AS_LIVE_PUBLISHED",
            "NO_BIP7_AS_BIP8",
            "NO_PYTHON_ROLE_CONFLATION"
          ]
        },
        "status": {"enum": ["PASS", "BLOCKED"]},
        "explanation": {"type": "string", "minLength": 50},
        "evidence_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
