{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liaoyoyo/InterSubMod/schemas/aggregate-release-acceptance.schema.json",
  "title": "InterSubMod aggregate research-handoff acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "repository_url",
    "source_commit",
    "generated_at",
    "overall_pass",
    "blocking_gates",
    "project_license_spdx",
    "gates"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_type": {"const": "aggregate_release_acceptance"},
    "repository_url": {"const": "https://github.com/liaoyoyo/InterSubMod"},
    "source_commit": {"$ref": "#/$defs/commit"},
    "generated_at": {"type": "string", "format": "date-time"},
    "overall_pass": {"const": true},
    "blocking_gates": {"type": "array", "maxItems": 0},
    "project_license_spdx": {
      "enum": ["GPL-3.0-only", "GPL-3.0-or-later"]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_19_of_19_replay",
        "registry_and_handoff_package",
        "repo_hygiene",
        "tracked_large_asset_policy",
        "clean_release_build",
        "ctest_complete",
        "python_tests_complete",
        "tiny_synthetic_e2e",
        "bip7_fresh_clone_acceptance",
        "bip8_fresh_clone_acceptance",
        "html_browser_qa_84",
        "docs_claim_link_validation",
        "public_claim_registry_158",
        "github_publication_commit_alignment",
        "github_branch_protection_required_ci",
        "full_history_secret_scan",
        "release_asset_sha256_roundtrip",
        "reader_ai_six_question_acceptance",
        "intersubmod_project_license_confirmation",
        "longlineage_preview_safety"
      ],
      "properties": {
        "authority_19_of_19_replay": {"$ref": "#/$defs/gate"},
        "registry_and_handoff_package": {"$ref": "#/$defs/gate"},
        "repo_hygiene": {"$ref": "#/$defs/gate"},
        "tracked_large_asset_policy": {"$ref": "#/$defs/gate"},
        "clean_release_build": {"$ref": "#/$defs/gate"},
        "ctest_complete": {"$ref": "#/$defs/gate"},
        "python_tests_complete": {"$ref": "#/$defs/gate"},
        "tiny_synthetic_e2e": {"$ref": "#/$defs/gate"},
        "bip7_fresh_clone_acceptance": {"$ref": "#/$defs/gate"},
        "bip8_fresh_clone_acceptance": {"$ref": "#/$defs/gate"},
        "html_browser_qa_84": {"$ref": "#/$defs/gate"},
        "docs_claim_link_validation": {"$ref": "#/$defs/gate"},
        "public_claim_registry_158": {"$ref": "#/$defs/gate"},
        "github_publication_commit_alignment": {"$ref": "#/$defs/gate"},
        "github_branch_protection_required_ci": {"$ref": "#/$defs/gate"},
        "full_history_secret_scan": {"$ref": "#/$defs/gate"},
        "release_asset_sha256_roundtrip": {"$ref": "#/$defs/gate"},
        "reader_ai_six_question_acceptance": {"$ref": "#/$defs/gate"},
        "intersubmod_project_license_confirmation": {"$ref": "#/$defs/gate"},
        "longlineage_preview_safety": {"$ref": "#/$defs/gate"}
      }
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "evidence_type",
        "subject_commit",
        "sha256",
        "uri",
        "verified_at"
      ],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "evidence_type": {
          "enum": [
            "GIT_RECEIPT",
            "CI_RECEIPT",
            "HOST_RECEIPT",
            "GITHUB_API_RECEIPT",
            "RELEASE_ASSET_RECEIPT",
            "READER_TEST_RECEIPT",
            "LICENSE_ATTESTATION"
          ]
        },
        "subject_commit": {"$ref": "#/$defs/commit"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "uri": {
          "type": "string",
          "pattern": "^[^:\\s]+$"
        },
        "verified_at": {"type": "string", "format": "date-time"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_commit", "verified_at", "evidence"],
      "properties": {
        "status": {"const": "PASS"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "verified_at": {"type": "string", "format": "date-time"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    }
  }
}
