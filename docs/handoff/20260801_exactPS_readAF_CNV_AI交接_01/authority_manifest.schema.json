{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://intersubmod.local/schema/exact-ps-tree-handoff-authority-1.0.0.json",
  "title": "InterSubMod exact-PS tree research AI handoff authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_name",
    "schema_version",
    "handoff_id",
    "as_of_date",
    "task_type",
    "project",
    "scope",
    "model_contract",
    "claim_boundary",
    "denominators",
    "tree_decision_policy",
    "artifacts",
    "implementation",
    "known_limitations",
    "deprecated_sources",
    "next_actions",
    "ai_startup"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_name": {
      "const": "intersubmod.exact_ps_tree_research.ai_handoff_authority"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "task_type": {
      "const": "D_handoff_to_external"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "repo_root",
        "primary_goal",
        "project_status",
        "paper_status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "repo_root": {
          "type": "string"
        },
        "primary_goal": {
          "type": "string"
        },
        "project_status": {
          "type": "string"
        },
        "paper_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "technical_datasets",
        "biological_ids",
        "technical_pair_note",
        "chromosomes",
        "primary_grain",
        "linkage_min_distinct_molecules",
        "maximum_original_block_k",
        "maximum_active_k"
      ],
      "properties": {
        "technical_datasets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "biological_ids": {
          "type": "integer",
          "minimum": 1
        },
        "technical_pair_note": {
          "type": "string"
        },
        "chromosomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^chr([1-9]|1[0-9]|2[0-2])$"
          },
          "uniqueItems": true
        },
        "primary_grain": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "linkage_min_distinct_molecules": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_original_block_k": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_active_k": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "model_contract": {
      "type": "object",
      "required": [
        "model_name",
        "mutation_model",
        "root",
        "edge_cost",
        "full_pattern_role",
        "partial_pattern_role",
        "primary_objective",
        "parent_mapping",
        "strict_perfect_phylogeny",
        "persistent_or_dollo_loss_model",
        "read_af_method",
        "read_af_role",
        "methyl_role"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "boolean"
        ]
      }
    },
    "claim_boundary": {
      "type": "object",
      "required": [
        "permitted",
        "forbidden",
        "canonical_sentence"
      ],
      "properties": {
        "permitted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "canonical_sentence": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "denominators": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "denominator": {
            "type": "integer",
            "minimum": 1
          },
          "percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "scope": {
            "type": "string"
          },
          "authority_id": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "tree_decision_policy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "status",
          "condition",
          "allowed_output",
          "forbidden_claim"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "NO_MUTATION_TREE_INFERENCE",
              "ABSTAIN_INCOMPLETE",
              "AF_ABSTAIN_RECURRENCE_SCREEN",
              "ABSTAIN_MODEL_MISMATCH",
              "EXACT_SINGLE_CANDIDATE_TREE",
              "TOPOLOGY_ONLY",
              "CANDIDATE_SET_ONLY",
              "TOPOLOGY_REPRESENTATIVE_ONLY",
              "CONSENSUS_BACKBONE_ONLY",
              "RAW_AF_UNIQUE_REPRESENTATIVE",
              "AF_CONDITIONAL_SINGLE_CANDIDATE_TREE"
            ]
          },
          "condition": {
            "type": "string"
          },
          "allowed_output": {
            "type": "string"
          },
          "forbidden_claim": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "role",
          "status",
          "path",
          "sha256",
          "schema_version",
          "scope",
          "claim_boundary"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "schema_version": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "claim_boundary": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "implementation": {
      "type": "object"
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deprecated_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "sequence",
          "priority",
          "depends_on",
          "owner",
          "status",
          "action",
          "verification",
          "definition_of_done"
        ],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^P[0-2]-[0-9]+$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P[0-2]-[0-9]+$"
            }
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "NOT_STARTED",
              "IN_PROGRESS",
              "BLOCKED",
              "COMPLETE"
            ]
          },
          "action": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          },
          "definition_of_done": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ai_startup": {
      "type": "object",
      "required": [
        "required_read_order",
        "required_checks",
        "stop_conditions"
      ],
      "properties": {
        "required_read_order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
