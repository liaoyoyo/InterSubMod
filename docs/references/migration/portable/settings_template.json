{
  "_comment": "用戶級 ~/.claude/settings.json 清洗模板 — 風格 portable",
  "_source": "從 /bip7_disk/liaoyoyo2001/.claude/settings.json 清洗；刪除所有 ISM 絕對路徑",
  "_usage": "scp 到新機 ~/.claude/settings.json；視需要重灌 plugins",

  "permissions": {
    "_comment_allow": "保留通用工具；專案 specific 路徑請在 <project>/.claude/settings.local.json 加入",
    "allow": [
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(awk:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(tree:*)",
      "Bash(xargs ls:*)",
      "Bash(xargs basename:*)",
      "Bash(xargs -I {} basename {})",
      "Bash(python3:*)",
      "Bash(python -m venv:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(bash:*)",
      "Bash(echo:*)",
      "Bash(cat)",
      "Bash(mount)",
      "Bash(dpkg:*)",
      "Bash(dpkg-deb:*)",
      "Bash(source:*)",
      "Bash(source ~/.bashrc)",

      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git log *)",
      "Bash(git stash *)",
      "Bash(gh repo:*)",
      "Bash(gh api:*)",

      "Bash(clang-format:*)",
      "Bash(samtools view:*)",
      "Bash(bcftools view:*)",
      "Bash(docker --version:*)",
      "Bash(docker compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(docker stop:*)",
      "Bash(docker rm:*)",

      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:pmc.ncbi.nlm.nih.gov)",
      "WebFetch(domain:www.nature.com)",
      "WebFetch(domain:link.springer.com)",
      "WebFetch(domain:genomebiology.biomedcentral.com)",

      "Bash(nohup bash *)",
      "Bash(disown)",
      "Bash(done)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf /*:*)",
      "Bash(mkfs:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*secret*)",
      "Read(**/*secrets*)",
      "Read(**/*token*)",
      "Read(**/*apikey*)",
      "Read(**/*api_key*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.ssh/**)",
      "Read(/etc/shadow)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(ln:*)",
      "Bash(truncate:*)",
      "Bash(dd:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git rebase:*)",
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(sudo:*)"
    ],
    "defaultMode": "dontAsk"
  },

  "enabledPlugins": {
    "_comment_plugins": "21 個 plugin；新機需 /plugin install 重灌；不啟用的設 false",
    "superpowers@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "sourcegraph@claude-plugins-official": false,
    "anthropic-skills@claude-plugins-official": false,
    "stripe@claude-plugins-official": false,
    "example-skills@anthropic-agent-skills": false,
    "document-skills@anthropic-agent-skills": false
  },

  "language": "繁體中文",
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
