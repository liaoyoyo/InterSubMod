# Secrets and local environment
.env
.env.*

# Python virtual environment and deps
.venv/
_deps/

# Large data directories
data/

# Logs
heatmap_generation.log

# Build artifacts
build/
*.o
*.a
*.so
*.d

# Large data files (analyze only, don't track)
*.bam
*.bai
*.vcf.gz
*.vcf.gz.tbi
*.tsv.gz
*.fastq
*.fastq.gz

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Large output directories (reference only)
output/
/big8_disk/

# IDE
.vscode/
.idea/
*.swp
*~

# Cycle result large files (keep summary only)
research/autoresearch/cycles/*/feature_obs.txt

# Research intermediate outputs — only reports (*.md), scripts (*.py), manifests
# (*.yaml/*.yml/*.json) and conclusion texts (*.txt) belong in git. Generated
# data tables, figures, and logs are never committed regardless of subdir layout.
research/**/data/
research/**/figures/
research/**/assets/
research/**/*.png
research/**/*.jpg
research/**/*.jpeg
research/**/*.pdf
research/**/*.svg
research/**/*.csv
research/**/*.tsv
research/**/*.bed
research/**/*.vcf
research/**/*.vcf.gz
research/**/*.bam
research/**/*.bai
research/**/*.gz
research/**/*.log

# Agent worktree isolation — temporary workspaces, not source of truth
.claude/worktrees/

# Root-level PDFs (presentations)
/*.pdf

# Stale directories
Testing/
slides/

# === image-gen / html-preview (added 2026-05-10, design doc D7) ===
# Generated PNGs not committed; prompts/ retained for reproducibility
**/figures/*.png
!**/figures/.gitkeep

# Codex CLI working dir (image gen output staging)
.codex_staging/

# === skill_usage_logger (added 2026-05-11, improvement #4) ===
# Per-machine telemetry log; not source of truth, no need to share
.claude/state/

# === Transient session/tooling artifacts (added 2026-05-11) ===
# HTML preview playground (per-session experiment output)
preview/
# Codex CLI 0-byte staging marker
.codex
# Claude Code scheduled task lock (transient runtime state)
.claude/scheduled_tasks.lock
# image-vision-check intermediate JSON (per-run instruction file)
examples/phase1_demo/demo_topic/figures/_check_instructions.json
